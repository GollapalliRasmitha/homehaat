# Copy to .env (start-homehaat.ps1 does this for you). Never commit .env.

# --- Django ---
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# The browser only ever talks to Next.js; Next.js proxies /api/* to Django.
FRONTEND_ORIGIN=http://localhost:3000

# --- Postgres (docker-compose.yml) ---
POSTGRES_DB=homehaat
POSTGRES_USER=homehaat
POSTGRES_PASSWORD=homehaat
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433

# --- Razorpay (TEST MODE ONLY, keys start with rzp_test_) ---
# See docs/razorpay-setup.md. These stay on the server; the frontend never sees the secrets.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Only needed once a webhook URL is registered in the Razorpay dashboard.
RAZORPAY_WEBHOOK_SECRET=

# --- AI listing helper (Stage 6) ---
# See docs/ai-setup.md. Free key from Google AI Studio; HomeHaat's own, never Oppora's.
AI_ENABLED=false
GEMINI_API_KEY=
# Optional: leave empty for the default (gemini-flash-lite-latest, then gemini-flash-latest as backup).
GEMINI_MODEL=

# --- Proxy secret (production) ---
# Set the SAME long random value here (Django) and as PROXY_SECRET for the Next.js app, so Django can trust the
# visitor IP the proxy passes on (sign-in rate limit per visitor). Leave empty locally.
PROXY_SECRET=

# --- Next.js server -> Django (used for server-side requests only) ---
API_INTERNAL_URL=http://127.0.0.1:8000
