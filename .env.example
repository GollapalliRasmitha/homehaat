# HomeHaat backend (Django) settings: NAMES ONLY. Never put real values in this file, and never commit .env.
#
# Locally: start-homehaat.ps1 copies this to .env on the first run and fills in the two local values it needs
# (a random DJANGO_SECRET_KEY and DJANGO_DEBUG=true). Everything left empty uses the local default shown in brackets.
# Online: the same names go in the Render dashboard (docs/deploy.md says which value goes where).
# The website's own settings are in frontend/.env.example.

# --- Django ---
# A long random string. Required when DJANGO_DEBUG is not true. (Render makes one for you.)
DJANGO_SECRET_KEY=
# true only on your own computer. Online it must be false (the default).
DJANGO_DEBUG=
# Extra server names, comma-separated [localhost,127.0.0.1]. Render's own address is added automatically.
DJANGO_ALLOWED_HOSTS=
# The address people visit, no slash at the end [http://localhost:3000]. Online: your Vercel address.
FRONTEND_ORIGIN=
# Optional: more site addresses allowed to send changes (e.g. a custom domain), comma-separated.
CSRF_TRUSTED_ORIGINS=

# --- Database ---
# Online: the Neon connection string (postgresql://...). When it's empty, the local Docker database below is used.
DATABASE_URL=
# Local Docker Postgres (docker-compose.yml) [homehaat / homehaat / homehaat / 127.0.0.1 / 5433]
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=
POSTGRES_PORT=

# --- Photos ---
# Online: cloudinary://... from the Cloudinary dashboard. Empty = photos are saved in MEDIA_ROOT on this computer.
CLOUDINARY_URL=
# Local folder for photos [backend/media]
MEDIA_ROOT=

# --- Razorpay (TEST MODE ONLY: the key id starts with rzp_test_). See docs/razorpay-setup.md. ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Only needed once a webhook URL is registered in the Razorpay dashboard (online).
RAZORPAY_WEBHOOK_SECRET=

# --- AI listing helper. See docs/ai-setup.md. ---
# true to switch it on (it also needs the key) [false]
AI_ENABLED=
GEMINI_API_KEY=
# Optional: a model to try first [gemini-flash-lite-latest, then gemini-flash-latest]
GEMINI_MODEL=

# --- Secrets shared with other services (online only; leave empty locally) ---
# The SAME long random value as PROXY_SECRET in Vercel: lets Django trust the visitor IP the website passes on.
PROXY_SECRET=
# The SAME long random value as the GitHub secret HOMEHAAT_JOBS_SECRET: lets the schedule run the jobs.
JOBS_SECRET=

# --- GuardRail (security monitoring; backend/guardrail/client.py). Off unless all three are set. ---
# Locally: true, http://localhost:3100, and the SAME value as INGEST_SECRET_HOMEHAAT in guardrail/.env.
GUARDRAIL_ENABLED=
GUARDRAIL_URL=
GUARDRAIL_SECRET=

# --- Admin account (online, Render has no shell). Created at deploy if no account has this email yet. ---
# Remove DJANGO_ADMIN_PASSWORD from the dashboard after the first deploy; the account stays.
DJANGO_ADMIN_EMAIL=
DJANGO_ADMIN_PASSWORD=
