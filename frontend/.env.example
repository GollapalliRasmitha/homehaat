# HomeHaat website (Next.js) settings: NAMES ONLY. Never put real values here.
# Locally you need none of them (the defaults below in brackets work). Online they go in the Vercel dashboard
# (Settings > Environment Variables), see docs/deploy.md. For a local override, copy this to frontend/.env.local.

# Where Django runs [http://127.0.0.1:8000]. On Vercel: the Render address, e.g. https://homehaat-api.onrender.com
# (no slash at the end). Read when the site is built: redeploy after changing it.
API_INTERNAL_URL=
# The SAME long random value as PROXY_SECRET on Render. Leave empty locally.
PROXY_SECRET=
